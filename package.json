{
  "name": "instagram-influencer-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --project tsconfig.json src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",

    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",

    "postinstall": "prisma generate",

    "test:scraper": "ts-node --project tsconfig.json src/testScraper.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "dotenv": "^16.4.4",
    "express": "^4.18.2",
    "playwright": "^1.42.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.19",
    "prisma": "5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}